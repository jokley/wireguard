# Verified production release: Authelia v4.39.1 for ARM64.
AUTHELIA_IMAGE=authelia/authelia@sha256:e325963609cc928861ffe8130c09111862df88dd8fcafbcd2c47e5ff0a4ae268
TZ=Europe/Vienna
AUTHELIA_STATE_DIR=./state
AUTHELIA_USERS_DATABASE_DIR=./runtime

AUTHELIA_NOTIFIER_SMTP_USERNAME=SET_ME_LOCALLY

# These paths point to local files. The files and their contents must not be committed.
AUTHELIA_JWT_SECRET_FILE=./secrets/authelia_jwt_secret
AUTHELIA_SESSION_SECRET_FILE=./secrets/authelia_session_secret
AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=./secrets/authelia_storage_encryption_key
AUTHELIA_SMTP_PASSWORD_FILE=./secrets/authelia_smtp_password
