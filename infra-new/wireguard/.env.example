# The verified production image is pinned directly in docker-compose.yml:
# ghcr.io/wg-easy/wg-easy@sha256:66352ccb4b5095992550aa567df5118a5152b6ed31be34b0a8e118a3c3a35bf5

# Existing persistent directory; do not copy, initialize, or mount concurrently.
WG_DATA_DIR=/root/.wg-easy

# Must remain unavailable while the legacy root stack is running.
WG_UDP_PORT=51820

# Values matching the current root Compose configuration.
WG_HOST=me.jokley.at
WG_DEFAULT_ADDRESS=100.64.0.x
WG_DEFAULT_DNS=
WG_PERSISTENT_KEEPALIVE=25
